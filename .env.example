NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_FACEBOOK_URL=

# Development default is "local" so refresh survives reload while the backend still returns tokens in JSON.
# For production launch, move refresh token to HttpOnly Secure SameSite cookie on the backend and set this to "memory".
NEXT_PUBLIC_AUTH_TOKEN_STORAGE=local

# Optional observability keys. Do not put private server secrets in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_SENTRY_DSN=
